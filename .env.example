# SUARA TK - Environment Variables Example
# Duplicate this file as .env.local for local development

# App Settings
NEXT_PUBLIC_APP_NAME="SUARA TK"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Admin Authentication
# Session secret used by middleware to validate admin cookie
# Change this to a long random string in production! e.g.: openssl rand -base64 32
ADMIN_SESSION_SECRET=suaratk-demo-session-2026

# Admin Credentials (server-side only, never exposed to client)
# In production, replace these with Supabase Auth
ADMIN_PASSWORD_HUMAS=humashimtek2026
ADMIN_PASSWORD_ADMIN=admin123

# Supabase Configuration (Optional for initial mock store, required for full DB connection)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

